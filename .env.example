# ─── Garmin Connect ───────────────────────────────────────────────────────────
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña
# Clave de cifrado local (contraseña de Garmin guardada en Supabase). La generan setup.ps1 / setup.sh si falta;
# tiene que ser la misma en todos tus ordenadores.
# ENCRYPTION_KEY=


# ─── Configuración del agente ─────────────────────────────────────────────────
# Usuario de Kairos para la batería de preguntas y las herramientas (tools/run_bateria.py, check_rls.py)
# KAIROS_USERNAME=tu_email@ejemplo.com

# El servidor MCP (garmin_mcp) se arranca solo con el Python de Kairos: no hay nada que configurar.
# Opcional: activar fallback/caché MCP de contingencia (por defecto: false)
# KAIROS_MCP_ENABLE_FALLBACK=false

# Base de conocimiento del atleta (RAG ligero): ficheros separados por coma (.md, .txt, .json).
# Si se deja vacío, se intenta cargar memory/athlete_knowledge.md, .txt o .json.
# ATHLETE_KB_PATHS=memory/athlete_knowledge.md,memory/pda_strategy.json

# Logging: nivel global (DEBUG | INFO | WARNING | ERROR | CRITICAL)
KAIROS_LOG_LEVEL=INFO
# Ruta del archivo de log (vacío para desactivar archivo)
KAIROS_LOG_FILE=agent.log
# Mostrar logs también en la terminal (true/false). Por defecto false: se mezclan con la conversación.
KAIROS_LOG_STDOUT=false
# Fichero para el stderr del servidor MCP (por defecto garmin_mcp.log)
# KAIROS_MCP_LOG_FILE=garmin_mcp.log
# Mensajes debug en consola interactiva (true/false)
KAIROS_DEBUG_CONSOLE=false


# ─── Supabase (obligatorio) ───────────────────────────────────────────────────
# Toda la memoria (perfil, historial, base de conocimiento, carga, proveedor de IA) se guarda en PostgreSQL
# (Supabase) por usuario, con Supabase Auth y RLS (supabase/README.md).
#
# Pasos:
#   1. Crea un proyecto en https://supabase.com (capa gratuita: 500 MB)
#   2. En el dashboard: Settings → API → copia Project URL y anon public key
#   3. Ejecuta supabase/schema.sql y supabase/rls.sql en: SQL Editor → New query → Run
#
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── Proveedor de IA ──────────────────────────────────────────────────────────
# No hace falta rellenar nada: la primera vez que entras, Kairos te pregunta tu proveedor de IA (cualquiera con
# API compatible con OpenAI), el modelo y tu clave. El proveedor y el modelo se guardan en Supabase (tabla
# ia_provider); la clave, aquí, en PROVIDER_API_KEY (la misma variable para cualquier proveedor, con un
# comentario encima que dice cuál es), nunca en la base de datos. Un .env antiguo con NVIDIA_API_KEY u otra
# <PROVEEDOR>_API_KEY se traslada solo a PROVIDER_API_KEY la primera vez.
# Si la clave caduca, Kairos la vuelve a pedir y la actualiza aquí. /proveedor lo cambia todo.
# KAIROS_MODEL cambia el modelo solo en esa ejecución (tools/run_bateria.py --modelo).
# Proveedor de IA de PROVIDER_API_KEY: NVIDIA NIM (nvidia/nemotron-3-ultra-550b-a55b)
# PROVIDER_API_KEY=


# ─── Proxy corporativo (Zscaler), solo si tu red lo usa ───────────────────────
# Certificados de Python + raíz del proxy. Sin esto, Garmin falla con CERTIFICATE_VERIFY_FAILED.
# REQUESTS_CA_BUNDLE=C:\ruta\a\ca_bundle.pem
# SSL_CERT_FILE=C:\ruta\a\ca_bundle.pem
