# ─── Garmin Connect ───────────────────────────────────────────────────────────
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña
# Cifra la contraseña de Garmin guardada en Supabase. La generan setup.ps1 / setup.sh si está vacía;
# tiene que ser la misma en todos tus ordenadores.
ENCRYPTION_KEY=


# ─── Configuración del agente ─────────────────────────────────────────────────
# Tu usuario de Kairos (lo usan las herramientas: tools/run_bateria.py, tools/check_rls.py)
KAIROS_USERNAME=tu_email@ejemplo.com


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Settings → API: Project URL y anon public key. Esquema: supabase/schema.sql y supabase/rls.sql.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── Proveedor de IA ──────────────────────────────────────────────────────────
# Kairos te pide la clave la primera vez y la escribe aquí; el proveedor y los modelos van en Supabase (ia_provider).
# Proveedor de IA de PROVIDER_API_KEY: (lo escribe Kairos)
PROVIDER_API_KEY=


# ─── Proxy corporativo (Zscaler), solo si tu red lo usa ───────────────────────
# Certificados de Python + raíz del proxy. Sin esto, Garmin falla con CERTIFICATE_VERIFY_FAILED.
# REQUESTS_CA_BUNDLE=C:\ruta\a\ca_bundle.pem
# SSL_CERT_FILE=C:\ruta\a\ca_bundle.pem
