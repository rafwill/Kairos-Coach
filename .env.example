# ─── Supabase (obligatorio) ─────────────────────────────────────────────────
# Te los da quien administra Kairos (en su proyecto: Settings → API: Project URL y anon public key).
# La clave anon no es secreta: con la seguridad por fila, sin tu sesión no deja ver nada (supabase/README.md).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── Tus secretos NO van aquí ─────────────────────────────────────────────────
# Kairos guarda tu contraseña de Garmin y la clave de tu proveedor de IA cifradas en Supabase Vault (06/11):
# te las pide la primera vez que entras y las lee de ahí en cualquier ordenador. Lo de abajo solo hace falta
# sin Vault (respaldo) o para arrancar el servidor de Garmin a mano (garmin_mcp/README.md).
# GARMIN_EMAIL=tu_email@ejemplo.com
# GARMIN_PASSWORD=tu_contraseña
# PROVIDER_API_KEY=
# Respaldo sin Vault: cifra la contraseña de Garmin guardada en Supabase. La generan setup.ps1 / setup.sh.
ENCRYPTION_KEY=


# ─── Herramientas de tools/ (opcional) ──────────────────────────────────────
# Tu usuario de Kairos para tools/run_bateria.py, tools/check_rls.py, etc. (o pásalo con --username).
# KAIROS_USERNAME=tu_email@ejemplo.com


# ─── Proxy o VPN, solo si tu red lo usa ─────────────────────────────────────
# Certificados de Python + raíz del proxy. Sin esto, Garmin falla con CERTIFICATE_VERIFY_FAILED.
# REQUESTS_CA_BUNDLE=C:\ruta\a\ca_bundle.pem
# SSL_CERT_FILE=C:\ruta\a\ca_bundle.pem
