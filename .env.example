# ─── Garmin Connect ───────────────────────────────────────────────────────────
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña

# ─── LLM Provider: opción 1 ───────────────────────────────────
# Groq — gratuito, 100k tokens/día, API compatible con OpenAI
# Registro en: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LLM Provider: opción 2 ─────────────────────
# Google AI Studio / Gemini — gratuito, ~1M tokens/día, API compatible con OpenAI
# Registro en: https://aistudio.google.com → Get API key (no requiere tarjeta)
GEMINI_API_KEY=AIzaSy_tu_clave_de_gemini
# Si no se define GEMINI_MODEL se usa gemini-2.0-flash (defecto del código).
# Otros modelos: gemini-2.5-flash (más calidad), gemini-2.5-flash-lite (más ligero)
GEMINI_MODEL=gemini-2.0-flash

# ─── LLM Provider: opción 3 (RECOMENDADA) ───────────────────────────────────
# NVIDIA NIM — API compatible OpenAI, capa gratuita generosa; funciona también desde la VPN del trabajo
# Registro en: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-...
# Modelos probados con la batería (21/10/2026):
# nvidia/nemotron-3-ultra-550b-a55b      → 550B (55B activos), más coherente, más lento ← recomendado
# nvidia/nemotron-3.5-lightning-30b-a3b  → 30B (3B activos), más rápido, más errores (defecto del código)
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ─── LLM Provider: opción 4 ───────────────────────────────────
# Mistral — capa gratuita, API compatible OpenAI
# Registro en: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ─── LLM Provider: opción 5 ───────────────────────────────────
# Cerebras — gratuito y muy rápido, API compatible OpenAI
# Registro en: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# ─── Supabase (obligatorio) ──────────────────────────────────────────
# Arquitectura actual: DB-first multiusuario.
# El agente requiere SUPABASE_URL y SUPABASE_ANON_KEY para arrancar.
# Toda la memoria (perfil, historial, base de conocimiento y cuota Gemini)
# se persiste en PostgreSQL (Supabase) por usuario.
#
# Pasos:
#   1. Crea un proyecto en https://supabase.com (capa gratuita: 500 MB)
#   2. En el dashboard: Settings → API → copia Project URL y anon public key
#   3. Ejecuta supabase/schema.sql en: SQL Editor → New query → Run
#
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Configuración del agente ─────────────────────────────────────────────────
# El servidor MCP (garmin_mcp) se arranca solo con el Python de Kairos: no hay nada que configurar.
# Opcional: activar fallback/caché MCP de contingencia (por defecto: false)
# KAIROS_MCP_ENABLE_FALLBACK=false

# Base de conocimiento del atleta (RAG ligero)
# Lista de ficheros separados por coma con notas personales del atleta.
# Soporta: .md, .txt, .json
# Si se deja vacío, el agente intentará cargar por defecto:
#   memory/athlete_knowledge.md
#   memory/athlete_knowledge.txt
#   memory/athlete_knowledge.json
# ATHLETE_KB_PATHS=memory/athlete_knowledge.md,memory/pda_strategy.json

# Usuario de Kairos para la batería de preguntas (tools/run_bateria.py)
# KAIROS_USERNAME=tu_email@ejemplo.com

# ─── Logging (producción) ────────────────────────────────────────────────────
# Nivel global de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
KAIROS_LOG_LEVEL=INFO
# Ruta del archivo de log (vacío para desactivar archivo)
KAIROS_LOG_FILE=agent.log
# Mostrar logs también en la terminal (true/false). Por defecto false: se mezclan con la conversación.
KAIROS_LOG_STDOUT=false
# Fichero para el stderr del servidor MCP (por defecto garmin_mcp.log)
# KAIROS_MCP_LOG_FILE=garmin_mcp.log
# Mensajes debug en consola interactiva (true/false)
KAIROS_DEBUG_CONSOLE=false

