# Credenciales — nunca subir al repo
.env

# Certificado corporativo (específico del entorno)
# Regenerar con: Export-Certificate -Cert (Get-ChildItem Cert:\LocalMachine\Root | Where Subject -like "*Zscaler*") -FilePath zscaler-ca.pem
zscaler-ca.pem

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# VS Code (configuración local de cada desarrollador)
.vscode/

# Runtime local (no versionar)
agent.log

# Real payload captures for offline forensic replay (sensitive/user data)
fixtures/real_payloads/*
!fixtures/real_payloads/.gitkeep

# Memoria local del usuario (puede contener datos personales)
memory/*
!memory/.gitkeep

# OS
.DS_Store
Thumbs.db


# Archivo local: evidencias, datos reales y herramientas de diagnóstico (no se sube)
_archivo/
.tmp/
workouts*.csv
